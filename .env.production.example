# Copy to .env.production on the VPS and fill in every value below.
# This file is consumed by docker-compose.prod.yml via env_file, and is
# shared by the postgres/minio containers AND the api/worker/web containers.

# ---------------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------------
NODE_ENV=production
APP_NAME=IndexPilot
APP_URL=https://your-domain.example
API_PORT=4000
API_HOST=0.0.0.0
CORS_ORIGINS=https://your-domain.example
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# DATABASE (container hostname "postgres", matches service name in compose)
# ---------------------------------------------------------------------------
POSTGRES_PASSWORD=replace-with-a-strong-password
DATABASE_URL=postgresql://indexpilot:replace-with-a-strong-password@postgres:5432/indexpilot?schema=public

# ---------------------------------------------------------------------------
# REDIS / QUEUES (container hostname "redis")
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379
WORKER_CONCURRENCY_VALIDATION=10
WORKER_CONCURRENCY_PROCESSING=10
WORKER_CONCURRENCY_VERIFICATION=5
WORKER_CONCURRENCY_REPORTS=2
VERIFICATION_FIRST_DELAY_HOURS=24
VERIFICATION_RECHECK_HOURS=72
VERIFICATION_MAX_CHECKS=4

# ---------------------------------------------------------------------------
# AUTH
# ---------------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-me
SESSION_TTL_HOURS=720
COOKIE_NAME=ip_session
COOKIE_SECURE=true
COOKIE_DOMAIN=your-domain.example
# 64 hex chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace-me

# ---------------------------------------------------------------------------
# URL VALIDATION / SSRF POLICY
# ---------------------------------------------------------------------------
FETCH_TIMEOUT_MS=10000
FETCH_MAX_REDIRECTS=5
FETCH_MAX_BODY_BYTES=524288
FETCH_USER_AGENT=IndexPilotBot/1.0 (+https://your-domain.example/bot)
ALLOW_PRIVATE_NETWORK_FETCH=false

# ---------------------------------------------------------------------------
# SUBMISSION LIMITS
# ---------------------------------------------------------------------------
MAX_URLS_PER_SUBMISSION=10000
MAX_UPLOAD_BYTES=10485760
CREDITS_PER_URL=1
SIGNUP_BONUS_CREDITS=50

# ---------------------------------------------------------------------------
# STORAGE
# Using the local driver for now (writes to a shared Docker volume mounted
# into api+worker) since MinIO's Docker Hub image access changed. Switch to
# STORAGE_DRIVER=s3 with a real S3-compatible provider (Cloudflare R2, AWS S3,
# a correctly-tagged self-hosted MinIO) later without touching anything else.
# ---------------------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./tmp/storage

# ---------------------------------------------------------------------------
# EMAIL
# ---------------------------------------------------------------------------
EMAIL_DRIVER=smtp
EMAIL_FROM=no-reply@your-domain.example
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=true

# ---------------------------------------------------------------------------
# PAYMENTS
# ---------------------------------------------------------------------------
PAYMENT_DRIVER=mock
PAYMENT_WEBHOOK_SECRET=replace-me
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# DISCOVERY PROVIDERS
# ---------------------------------------------------------------------------
DEFAULT_DISCOVERY_PROVIDERS=mock
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=

# ---------------------------------------------------------------------------
# OBSERVABILITY
# ---------------------------------------------------------------------------
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=

# ---------------------------------------------------------------------------
# PUBLIC SEO TOOLS (/tools)
# ---------------------------------------------------------------------------
TOOLS_ENABLED=true
TOOLS_RATE_LIMIT_ANON_PER_HOUR=60
TOOLS_RATE_LIMIT_USER_PER_HOUR=600
TOOLS_CACHE_TTL_SECONDS=900
TOOLS_FETCH_TIMEOUT_MS=10000
TOOLS_SITEMAP_URL_LIMIT_ANON=100
TOOLS_SITEMAP_URL_LIMIT_USER=500
TOOLS_SITEMAP_CONCURRENCY=6
