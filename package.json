{
  "name": "indexpilot",
  "version": "1.0.0",
  "private": true,
  "description": "URL Discovery & Indexing Platform - SaaS for bulk URL submission, validation, discovery assistance and index-status verification",
  "engines": { "node": ">=20.11.0" },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "concurrently -n api,worker,web -c blue,magenta,green \"pnpm --filter @indexpilot/api dev\" \"pnpm --filter @indexpilot/worker dev\" \"pnpm --filter @indexpilot/web dev\"",
    "dev:api": "pnpm --filter @indexpilot/api dev",
    "dev:worker": "pnpm --filter @indexpilot/worker dev",
    "dev:web": "pnpm --filter @indexpilot/web dev",
    "build": "pnpm db:generate && pnpm --filter @indexpilot/api build && pnpm --filter @indexpilot/worker build && pnpm --filter @indexpilot/web build",
    "start:api": "pnpm --filter @indexpilot/api start",
    "start:worker": "pnpm --filter @indexpilot/worker start",
    "start:web": "pnpm --filter @indexpilot/web start",
    "typecheck": "pnpm -r --no-bail typecheck",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "db:generate": "pnpm --filter @indexpilot/db generate",
    "db:migrate": "pnpm --filter @indexpilot/db migrate",
    "db:migrate:deploy": "pnpm --filter @indexpilot/db migrate:deploy",
    "db:seed": "pnpm --filter @indexpilot/db seed",
    "db:studio": "pnpm --filter @indexpilot/db studio",
    "db:reset": "pnpm --filter @indexpilot/db reset",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "@playwright/test": "^1.49.1",
    "dotenv": "^16.4.7"
  }
}
